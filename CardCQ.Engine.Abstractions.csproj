<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>CardCQ.Engine.Abstractions</PackageId>
    <Version>1.0.0</Version>
    <Description>Abstractions (commands, queries, events and handlers) for the CardCQ engine.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- Imported by every project that references this package: turns CardCQColor/CardCQScope into package metadata. -->
    <None Include="build\CardCQ.Engine.Abstractions.targets" Pack="true" PackagePath="build" />
  </ItemGroup>

</Project>
